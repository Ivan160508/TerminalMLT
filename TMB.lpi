        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="formsetcolors.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormColors"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="FormSetColors"/>
      </Unit>
      <Unit>
