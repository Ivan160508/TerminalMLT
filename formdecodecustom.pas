procedure TFormCustomDecode.FormActivate(Sender: TObject);
var
  i : integer;
  ItemStrTmp : pTItemDecodeCustom;
begin
  ItemStrTmp := ItemStr;
  //Perform(WM_SETREDRAW, 1,0);
  for i := 0 to 255 do
    begin
      CustDecodTablCur[i] := ItemStrTmp^.StrDecode;
      EdtDecod[i].Text    := CustDecodTablCur[i];
      CustDecodTablTmp[i] := CustDecodTablCur[i];
      EdtDecod[i].Color   := clWindow;
      inc(ItemStrTmp);
    end;
  //Perform(WM_SETREDRAW, 0,0);
  //Refresh;
end;

procedure TFormCustomDecode.FormClose(Sender: TObject;
  var CloseAction: TCloseAction);
begin

end;

procedure TFormCustomDecode.EditChange(Sender: TObject);
var
  num : byte;
begin
  num := (Sender as TEdit).Tag;
  CustDecodTablTmp[num] := (Sender as TEdit).Text;
  if CustDecodTablCur[num] <> CustDecodTablTmp[num] then
    (Sender as TEdit).Color := clYellow
  else
    (Sender as TEdit).Color := clWindow;
end;

procedure TFormCustomDecode.BtASCII_NPClick(Sender: TObject);
var
  i : byte;
begin
  for i := 0 to 255 do
    begin
      CustDecodTablTmp[i] := ByteToAsciiTabl[i];
      EdtDecod[i].Text    := CustDecodTablTmp[i];
    end;
end;

procedure TFormCustomDecode.BtExitClick(Sender: TObject);
begin
  FormCustomDecode.Close;
end;

procedure TFormCustomDecode.BtSaveClick(Sender: TObject);
var
  i : integer;
  ItemStrTmp : pTItemDecodeCustom;
begin
  ItemStrTmp := ItemStr;
  for i := 0 to 255 do
    begin
      CustDecodTablCur[i] := CustDecodTablTmp[i];
      ItemStr^.StrDecode  := CustDecodTablCur[i];
      EdtDecod[i].Color   := clWindow;
      inc(ItemStr);
    end;
  ItemStr := ItemStrTmp;
end;


function BinB(b: Byte): string;
 var
   s: string;
   i: word;
 begin
   s := '';
   for i := 7 downto 0 do
     if (b and (1 shl i)) > 0 then
       s := s + '1'
   else
     s := s + '0';
   BinB := s;
 end;

procedure TFormCustomDecode.Bt_BINClick(Sender: TObject);
var
  i : byte;
begin
  for i := 0 to 255 do
    begin
      CustDecodTablTmp[i] := BinB(i) + ' ';
      EdtDecod[i].Text    := CustDecodTablTmp[i];
    end;
end;

procedure TFormCustomDecode.Bt_CurClick(Sender: TObject);
var
  i : byte;
begin
  for i := 0 to 255 do
    begin
      CustDecodTablTmp[i] := CustDecodTablCur[i];
      EdtDecod[i].Text    := CustDecodTablTmp[i];
    end;
end;

procedure TFormCustomDecode.BT_DECClick(Sender: TObject);
var
  i : byte;
begin
  for i := 0 to 255 do
    begin
      CustDecodTablTmp[i] := Format('%.3d ', [i]);
      EdtDecod[i].Text    := CustDecodTablTmp[i];
    end;
end;

procedure TFormCustomDecode.Bt_HEXClick(Sender: TObject);
var
  i : byte;
begin
  for i := 0 to 255 do
    begin
      CustDecodTablTmp[i] := IntToHex(i, 2) + ' ';
      EdtDecod[i].Text    := CustDecodTablTmp[i];
    end;
end;

procedure TFormCustomDecode.EditDblClick(Sender: TObject);
